{
    "name": "api",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "MIT",
    "scripts": {
        "build": "nest build",
        "build:with:frontend": "nest build && npm run build --prefix ../permata-kasir-frontend",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "pm2 start dist/main.js --name permata-kasir-backend",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "db:deploy": "prisma migrate deploy",
        "db:migrate": "prisma migrate dev --skip-generate",
        "db:generate": "prisma generate",
        "db:studio": "prisma studio",
        "db:update": "rm -f -R prisma/database.sqlite && rm -f -R prisma/migrations && rm -f -R models && npm run db:migrate && npm run db:deploy && npm run db:generate",
        "git:commit": "git add . && git commit -m",
        "git:push": "git push -u origin main"
    },
    "dependencies": {
        "@nestjs/cache-manager": "^12.0.0",
        "@nestjs/common": "^11.0.1",
        "@nestjs/config": "^1.1.5",
        "@nestjs/core": "^11.0.1",
        "@nestjs/jwt": "^11.0.0",
        "@nestjs/mapped-types": "*",
        "@nestjs/platform-express": "^11.0.1",
        "@nestjs/platform-socket.io": "^11.1.5",
        "@nestjs/serve-static": "^5.0.3",
        "@nestjs/websockets": "^11.1.5",
        "@prisma/client": "^6.12.0",
        "bcrypt": "^6.0.0",
        "cache-manager": "^7.2.9",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "dotenv": "^17.2.3",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.18.0",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.1",
        "@swc/cli": "^0.6.0",
        "@swc/core": "^1.10.7",
        "@types/bcrypt": "^6.0.0",
        "@types/express": "^5.0.0",
        "@types/multer": "^2.0.0",
        "@types/node": "^22.10.7",
        "@types/supertest": "^6.0.2",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.2",
        "globals": "^16.0.0",
        "prettier": "^3.4.2",
        "prisma": "^6.12.0",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0"
    }
